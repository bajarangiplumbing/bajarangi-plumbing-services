# Copy to .env and fill in locally. Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Comma-separated. Add the EC2 instance IP here.
# TODO: Add your custom domain here once configured (e.g. 1.2.3.4,example.com)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,<EC2_INSTANCE_IP>

# PostgreSQL connection URL, read by plumber_site/settings.py. Neon gives
# you this string ready to paste - use the pooled (-pooler) host it shows
# by default, and keep sslmode=require:
#   postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
# Leave it blank and local development falls back to SQLite. It is
# REQUIRED when DJANGO_DEBUG is off - settings.py refuses to start
# otherwise, so a production deploy cannot silently run on SQLite.
DATABASE_URL=

# Comma-separated, only needed when DJANGO_DEBUG is off.
# e.g. https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Site identity, read by core/context_processors.py ---
# Absolute origin, no trailing slash. Used for canonical URLs, og:url and
# the JSON-LD @id. Leave blank and those render document-relative, which
# is valid but weaker - set it before launch (implementation_plan.md §8).
SITE_URL=

# Contact identity. These are the real published values - the placeholder
# launch blocker in implementation_plan.md §3 item 1 / §14.8 is closed.
# Setting them here updates all 15 pages at once, which is what the §8
# NAP-consistency rule requires. Keep all three in step with each other:
# display is human-readable, tel is E.164, wa is digits only.
SETU_PHONE_DISPLAY=+91 xxxxxxxxxx
SETU_PHONE_TEL=+91xxxxxxxxxx
SETU_WA_NUMBER=91xxxxxxxxxx

# --- Legal identity (compliance review, September 2026) ---
# REQUIRED BEFORE ANY PUBLIC DEPLOY. core/checks.py refuses to start when
# DJANGO_DEBUG is off and these are missing, so a production build fails
# rather than publishing a site with no identifiable trader
# behind it. Checks core.E003 / core.E004 / core.E005.
#
# Why each one is not optional:
#
#   BUSINESS_PROPRIETOR
#     The sole proprietor's full legal name. "Bajarangi Plumbing Services"
#     is a trading style; on its own it names no person or registered
#     entity, so a customer relying on the terms of service has nobody to
#     enforce them against. Consumer Protection Act 2019 and the
#     E-Commerce Rules 2020 both assume an identifiable trader.
#
#   BUSINESS_ADDRESS_STREET (+ optional LOCALITY / PIN)
#     "Bhubaneswar, Odisha, India" is a city, not an address that can
#     receive a legal notice or a consumer complaint. A home address is
#     perfectly acceptable for a proprietor working from home. CITY and
#     STATE already default to Bhubaneswar / Odisha.
#
#   BUSINESS_EMAIL  (and GRIEVANCE_EMAIL, if a different inbox)
#     The forms collect name, phone, address and a free-text problem
#     description behind a consent checkbox. That makes this business a
#     Data Fiduciary under the DPDP Act 2023, and s.13 requires a
#     published contact for grievances and for rights requests (access,
#     correction, erasure). WhatsApp alone will not do: a rights request
#     needs a written, timestamped channel that can evidence a reply.
#     DPDP Rules 2025 were notified 13 Nov 2025; the notice, consent and
#     erasure duties are fully enforceable from 13 May 2027.
BUSINESS_PROPRIETOR=
BUSINESS_ADDRESS_STREET=
BUSINESS_ADDRESS_LOCALITY=
BUSINESS_ADDRESS_CITY=Bhubaneswar
BUSINESS_ADDRESS_STATE=Odisha
BUSINESS_ADDRESS_PIN=
BUSINESS_EMAIL=
GRIEVANCE_CONTACT_NAME=
GRIEVANCE_EMAIL=

# Optional. Warning core.W001 only - a proprietor below the GST
# registration threshold genuinely has none.
# DO NOT invent a value to silence the warning: a wrong GSTIN is a false
# statement to a consumer and to the tax authority. A missing one is
# merely incomplete.
BUSINESS_GSTIN=

# Entity description shown on the legal pages. Change only if the
# business is not a sole proprietorship.
BUSINESS_ENTITY_TYPE=Sole proprietorship

# --- Data retention (DPDP Rules 2025) ---
# The privacy policy publishes these periods and
# `manage.py purge_expired_leads` enforces them, so the policy text and
# the code cannot drift apart. Defaults shown; override only with a
# decision the business has actually taken.
#
#   RETENTION_ENQUIRY_DAYS  enquiries that never became a job
#   RETENTION_JOB_DAYS      records of completed work. 550 days (~18
#                           months) is the pragmatic floor: the Consumer
#                           Protection Act 2019 gives a consumer two
#                           years from the cause of action to complain,
#                           and answering a workmanship dispute needs the
#                           job record.
#   RETENTION_IP_DAYS       submission IP only. It is the least necessary
#                           field on the record and is erased first,
#                           separately from the rest of the lead.
# RETENTION_ENQUIRY_DAYS=180
# RETENTION_JOB_DAYS=550
# RETENTION_IP_DAYS=30

# --- Owner alerts, read by core/notifications.py ---
# backend_plan.md §11. Leave any of these blank and that alert channel
# simply fails and is recorded on the Lead row; the lead itself is still
# saved (§7.1), so a missing credential never costs you a lead.

# WhatsApp Cloud API (Path A - direct Meta, no BSP). All three come from
# the one-time console setup in backend_plan.md §9:
#   WHATSAPP_ACCESS_TOKEN     system-user token scoped to
#                             whatsapp_business_messaging. A SECRET -
#                             .env only, never committed.
#   WHATSAPP_PHONE_NUMBER_ID  shown beside the connected number in the
#                             WhatsApp Manager dashboard (numeric ID, not
#                             the phone number itself).
#   OWNER_WHATSAPP_NUMBER     Bajarangi's own receiving number, digits
#                             only with country code, no '+' or spaces,
#                             i.e. 91xxxxxxxxxx.
# Sending also needs the approved 'new_lead_alert' Utility template
# (§4, §9 step 6) - the code sends that template by name.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP_NUMBER=

# Email fallback (Brevo, free tier). Used only when the WhatsApp call
# fails, which is what makes email_alert_status in Django Admin a
# "something went wrong" flag (§8).
#   BREVO_API_KEY     A SECRET - .env only, never committed.
#   ALERT_FROM_EMAIL  sender address on a Brevo-verified domain.
#   OWNER_ALERT_EMAIL where the alert lands.
BREVO_API_KEY=
ALERT_FROM_EMAIL=
OWNER_ALERT_EMAIL=

# --- Error monitoring (backend_plan.md §10, §12 step 7) ---
# Sentry free tier. Blank disables it entirely, which is the local
# default; set it in your production environment.
SENTRY_DSN=

# --- Who is the caller? (security review H2) ---
# Read plumber_site/settings.py's notes and core/security.py's client_ip()
# before touching these. They decide what the abuse limits below are keyed
# on, so getting them wrong disables the limits rather than loosening them.
#
# Leave BOTH blank in local development: that means REMOTE_ADDR, which is
# correct when nothing sits in front of Django.
#
# In production, set them to match the real topology exactly. Trusting a
# header the deployment does not actually set is worse than trusting none,
# because any caller can then forge it and opt out of every limit:
#
#   Cloudflare proxying (orange cloud):
#     CLIENT_IP_HEADER=CF-Connecting-IP
#   Direct proxy (e.g. Nginx on EC2):
#     CLIENT_IP_HEADER=X-Forwarded-For
#     CLIENT_IP_TRUSTED_PROXIES=1
#   Cloudflare proxy in front of Nginx, read via XFF:
#     CLIENT_IP_HEADER=X-Forwarded-For
#     CLIENT_IP_TRUSTED_PROXIES=2
CLIENT_IP_HEADER=
CLIENT_IP_TRUSTED_PROXIES=1

# --- Abuse limits (security review H2/M2) ---
# All optional; the defaults shown are what the code uses if left blank.
# The per-day caps are counted in the database rather than in a cache, so
# they cannot be reset by a deploy - which matters because every accepted
# lead costs a real WhatsApp Utility send.
#
# A visitor who trips a cap has not lost their enquiry: the browser's own
# wa.me handoff is untouched and still delivers their message.
#
# LEAD_MAX_PER_IP=5                  per LEAD_RATE_WINDOW_SECONDS
# LEAD_RATE_WINDOW_SECONDS=600
# LEAD_MAX_PER_IP_PER_DAY=20
# LEAD_MAX_PER_PHONE_PER_DAY=5
# LEAD_DEDUPE_WINDOW_MINUTES=5

# Admin login lockout (security review H4). Failures are counted per IP,
# never per username, so nobody can lock the owner out of his own console
# by deliberately guessing at his account.
# ADMIN_LOGIN_MAX_FAILURES=10
# ADMIN_LOGIN_LOCKOUT_SECONDS=900

# --- CI only: nightly backup encryption (security review M5) ---
# NOT used by the Django app and NOT needed in .env. This is a masked,
# protected CI/CD variable in GitLab (Settings -> CI/CD -> Variables),
# listed here so the requirement is discoverable in one place.
#
# The nightly-db-backup job refuses to run without it rather than
# publishing a plaintext dump of customer data. Keep the passphrase
# somewhere durable and offline as well - a dump you cannot decrypt is not
# a backup.
# BACKUP_GPG_PASSPHRASE=
